// SS CREATION JEWELLERY — Database Schema
// Provider: MySQL | ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// 1. ROLES & USERS
// ==========================================================

enum RoleName {
  CUSTOMER
  ADMIN
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name")
  email        String   @unique
  mobile       String   @unique
  passwordHash String   @map("password_hash")
  roleId       Int      @map("role_id")
  role         Role     @relation(fields: [roleId], references: [id])
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  isDemo       Boolean  @default(false) @map("is_demo")

  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]
  reviews       Review[]
  recentlyViewed RecentlyViewed[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String   @default("Home") // Home | Work | Other
  fullName     String   @map("full_name")
  phone        String
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false) @map("is_default")
  orders       Order[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("addresses")
}

// ==========================================================
// 2. CATALOG: CATEGORIES, COLLECTIONS, PRODUCTS
// ==========================================================

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  imageUrl String?   @map("image_url")
  isActive Boolean   @default(true) @map("is_active")
  products Product[]
  // A collection can optionally be scoped to one category (e.g. "Halo"
  // only makes sense under Rings) so the admin product form's Collection
  // dropdown — and the frontend mega-menu — can both read the same,
  // single, category-specific list instead of maintaining two copies.
  collections Collection[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Collection {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  slug       String    @unique
  imageUrl   String?   @map("image_url")
  // Nullable: leave unset for collections that span every category
  // (e.g. "Diamond Collection", "Gold Collection", "Bridal Collection"
  // used on the homepage hero) or set it to scope the collection to one
  // category (e.g. "Halo" → Rings). SetNull on delete so removing a
  // category never deletes a collection, only unscopes it.
  categoryId Int?      @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products   Product[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("collections")
}

enum Gender {
  WOMEN
  MEN
  UNISEX
  KIDS
}

model Product {
  id               Int       @id @default(autoincrement())
  sku              String    @unique
  name             String
  slug             String    @unique
  categoryId       Int       @map("category_id")
  category         Category  @relation(fields: [categoryId], references: [id])
  collectionId     Int?      @map("collection_id")
  collection       Collection? @relation(fields: [collectionId], references: [id])

  material         String    // e.g. "18K Gold", "Platinum"
  goldPurity       String?   @map("gold_purity") // e.g. "22K", "18K"
  goldWeightGrams  Float?    @map("gold_weight_grams")
  diamondWeightCt  Float?    @map("diamond_weight_ct")
  diamondQuality   String?   @map("diamond_quality") // e.g. "VVS1, F"
  certification    String?   // e.g. "IGI Certified"
  gender           Gender    @default(UNISEX)
  occasion         String?   // e.g. "Bridal", "Daily Wear", "Festive"

  price            Decimal   @db.Decimal(10, 2)
  originalPrice    Decimal   @db.Decimal(10, 2) @map("original_price")
  discountPercent  Float     @default(0) @map("discount_percent")

  stockQuantity    Int       @default(0) @map("stock_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  status           String    @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED

  description      String    @db.Text
  careInstructions String?   @db.Text @map("care_instructions")
  shippingInfo     String?   @db.Text @map("shipping_info")
  returnInfo       String?   @db.Text @map("return_info")

  isFeatured  Boolean @default(false) @map("is_featured")
  isNewArrival Boolean @default(false) @map("is_new_arrival")
  isBestSeller Boolean @default(false) @map("is_best_seller")

  // Automatic gold pricing (opt-in, additive) — see lib/gold-pricing.ts.
  // When autoGoldPricing is true, `price`/`originalPrice` above are
  // computed and kept in sync from goldWeightGrams + goldPurity + the
  // shared GoldRate row + these charges, instead of being entered by
  // hand. Non-gold products simply never set this flag and are
  // completely unaffected.
  autoGoldPricing    Boolean @default(false) @map("auto_gold_pricing")
  makingChargeType   String  @default("PERCENTAGE") @map("making_charge_type") // PERCENTAGE | FLAT
  makingChargeValue  Decimal @default(0) @db.Decimal(10, 2) @map("making_charge_value")
  otherChargesAmount Decimal @default(0) @db.Decimal(10, 2) @map("other_charges_amount")

  images          ProductImage[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  priceHistory    PriceHistory[]
  inventoryLogs   InventoryLog[]
  recentlyViewed  RecentlyViewed[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([collectionId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  @@index([productId])
  @@map("product_images")
}

model RecentlyViewed {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@unique([userId, productId])
  @@map("recently_viewed")
}

// ==========================================================
// 3. CART
// ==========================================================

model Cart {
  id     Int        @id @default(autoincrement())
  userId Int        @unique @map("user_id")
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int     @map("cart_id")
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ==========================================================
// 4. WISHLIST
// ==========================================================

model Wishlist {
  id     Int            @id @default(autoincrement())
  userId Int            @unique @map("user_id")
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("wishlists")
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int      @map("wishlist_id")
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ==========================================================
// 5. ORDERS & PAYMENTS
// ==========================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              Int      @id @default(autoincrement())
  orderNumber     String   @unique @map("order_number")
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id])

  customerName    String   @map("customer_name")
  customerEmail   String   @map("customer_email")
  customerMobile  String   @map("customer_mobile")

  addressId       Int?     @map("address_id")
  address         Address? @relation(fields: [addressId], references: [id])
  shippingAddressSnapshot String @db.Text @map("shipping_address_snapshot")

  subtotal        Decimal  @db.Decimal(10, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(10, 2) @map("discount_amount")
  taxAmount       Decimal  @default(0) @db.Decimal(10, 2) @map("tax_amount")
  shippingAmount  Decimal  @default(0) @db.Decimal(10, 2) @map("shipping_amount")
  totalAmount     Decimal  @db.Decimal(10, 2) @map("total_amount")

  orderStatus     OrderStatus   @default(PENDING) @map("order_status")
  isDemo          Boolean  @default(false) @map("is_demo")

  items    OrderItem[]
  payment  Payment?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([orderStatus])
  @@map("orders")
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int     @map("order_id")
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int     @map("product_id")
  product    Product @relation(fields: [productId], references: [id])
  productName String @map("product_name") // snapshot
  productSku  String @map("product_sku")  // snapshot
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2) @map("unit_price")
  lineTotal  Decimal @db.Decimal(10, 2) @map("line_total")

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @unique @map("order_id")
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        String        @default("DEMO") // DEMO | RAZORPAY | STRIPE
  status        PaymentStatus @default(PENDING)
  transactionRef String?      @map("transaction_ref")
  amount        Decimal       @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

// ==========================================================
// 6. REVIEWS
// ==========================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        Int          @id @default(autoincrement())
  productId Int          @map("product_id")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int          @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int          // 1-5
  title     String
  body      String       @db.Text
  status    ReviewStatus @default(PENDING)
  isDemo    Boolean      @default(false) @map("is_demo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("reviews")
}

// ==========================================================
// 7. PRICE MONITORING
// ==========================================================

model PriceHistory {
  id              Int      @id @default(autoincrement())
  productId       Int      @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  previousPrice   Decimal  @db.Decimal(10, 2) @map("previous_price")
  newPrice        Decimal  @db.Decimal(10, 2) @map("new_price")
  changeAmount    Decimal  @db.Decimal(10, 2) @map("change_amount")
  changePercent   Float    @map("change_percent")
  changedByUserId Int?     @map("changed_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("price_history")
}

// ==========================================================
// 8. INVENTORY
// ==========================================================

model InventoryLog {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  changeType    String   @map("change_type") // RESTOCK | SALE | ADJUSTMENT | RETURN
  quantityChange Int     @map("quantity_change") // + or -
  quantityAfter Int      @map("quantity_after")
  note          String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("inventory_logs")
}

// ==========================================================
// 9. NEWSLETTER
// ==========================================================

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  status    String   @default("ACTIVE") // ACTIVE | UNSUBSCRIBED
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

// ==========================================================
// 10. COUPONS / OFFERS  (Admin Panel Phase 3 — additive only,
// no existing model/field touched or removed)
// ==========================================================

enum CouponType {
  PERCENTAGE
  FLAT
}

model Coupon {
  id                Int        @id @default(autoincrement())
  code              String     @unique
  description       String?
  type              CouponType @default(PERCENTAGE)
  discountValue     Decimal    @db.Decimal(10, 2) @map("discount_value")
  minOrderValue     Decimal    @default(0) @db.Decimal(10, 2) @map("min_order_value")
  maxDiscountAmount Decimal?   @db.Decimal(10, 2) @map("max_discount_amount")
  usageLimit        Int?       @map("usage_limit")
  usedCount         Int        @default(0) @map("used_count")
  startsAt          DateTime?  @map("starts_at")
  expiresAt         DateTime?  @map("expires_at")
  isActive          Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coupons")
}

// ==========================================================
// 11. GOLD RATE (automatic gold pricing)
// ==========================================================
// Single-row settings table (always id 1). Updating it triggers a
// recompute of every product with autoGoldPricing: true — see
// /api/admin/gold-rate and lib/gold-pricing.ts.

model GoldRate {
  id             Int      @id @default(autoincrement())
  ratePerGram24k Decimal  @db.Decimal(10, 2) @map("rate_per_gram_24k")
  updatedByEmail String?  @map("updated_by_email")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("gold_rate")
}

// ==========================================================
// 12. HOMEPAGE BANNERS  (additive only)
// ==========================================================

model Banner {
  id           Int      @id @default(autoincrement())
  title        String
  subtitle     String?
  imageUrl     String   @map("image_url")
  linkUrl      String?  @map("link_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}
