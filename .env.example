# =========================================================
# SS CREATION JEWELLERY — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.
# =========================================================

# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:scott@localhost:3306/ss_creation_jewellery"

# JWT secret used to sign customer & admin auth tokens.
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Seed script (prisma/seed.ts) creates/updates exactly one ADMIN user
# from these two values — run `npm run seed` after setting them.
ADMIN_EMAIL="admin@sscreation.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
# Optional — only used on first creation, defaults shown below.
# ADMIN_MOBILE="9999999999"
# ADMIN_NAME="SS Creation Admin"

# Base URL of the running app (used in emails / links later)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp contact button — digits only, with country code, no "+" or
# spaces (e.g. "919930701983"). Defaults to the number already shown on
# /contact and in the Footer (lib/site-config.ts) if left unset.
# NEXT_PUBLIC_WHATSAPP_NUMBER="919930701983"

# SMTP — required for real "Forgot Password" emails to actually send.
# Without these set, the reset-password flow still works end to end
# (token generated, stored, validated), but the email is only logged to
# the server console instead of delivered — see lib/email.ts.
# Example values for Gmail (use an App Password, not your real
# password): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SS Creation Jewellery <no-reply@yourdomain.com>"

# Razorpay — NOT currently integrated in this project (checkout uses a
# simulated/demo payment flow, see CheckoutClient.tsx and
# app/api/orders/route.ts). Leave unset unless you're adding real
# Razorpay integration yourself.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# NEXT_PUBLIC_RAZORPAY_KEY_ID=""
